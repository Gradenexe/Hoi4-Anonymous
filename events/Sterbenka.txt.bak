# Crimia rebelion
country_event = {
	id = sterbenka.6
	title = sterbenka.6.t
	desc = sterbenka.6.d
	picture = GFX_decision_cat_picture_soviet_civil_war
	
	trigger = {
		tag = UKR
		UKR = { 
			is_subject = no 
			exists = yes
		}
		or = {
			137 = { is_controlled_by = UKR }
			any_country_with_original_tag = {
				original_tag_to_check = SOV
				controls_state = 137
			}
		}
	}
	
	immediate = {
		hidden_effect = {
			every_country = {
				limit = {
					original_tag = SOV
					has_civil_war = yes
				}
				release_on_controlled = CRI
				declare_war_on = {
					target = CRI
					type = annex_everything
				}
			}
			if = {
				limit = {
					137 = { is_controlled_by = UKR }
				}
				UKR = { release_on_controlled = CRI }
			}
			CRI = {
				division_template = {
					name = "Crimea Division"
					priority = 1
					division_names_group = CRI_INF_01
					regiments = {
						infantry = { x = 0 y = 0 }
						infantry = { x = 0 y = 1 }
						infantry = { x = 0 y = 2 }
				
						infantry = { x = 1 y = 0 }
						infantry = { x = 1 y = 1 }
						infantry = { x = 1 y = 2 }
					}
					support = {
						engineer = { x = 0 y = 0 }
					}
				}
				random_owned_controlled_state = {
					limit = { PREV = { has_full_control_of_state = PREV } }
					create_unit = {
						division = "name = \"isyançılar\" division_template = \"Crimea Division\" start_experience_factor = 0.2" 
						owner = PREV
					}
				}
				random_owned_controlled_state = {
					limit = { PREV = { has_full_control_of_state = PREV } }
					create_unit = {
						division = "name = \"isyançılar\" division_template = \"Crimea Division\" start_experience_factor = 0.2" 
						owner = PREV
					}
				}
				random_owned_controlled_state = {
					limit = { PREV = { has_full_control_of_state = PREV } }
					create_unit = {
						division = "name = \"isyançılar\" division_template = \"Crimea Division\" start_experience_factor = 0.2" 
						owner = PREV
					}
				}
				random_owned_controlled_state = {
					limit = { PREV = { has_full_control_of_state = PREV } }
					create_unit = {
						division = "name = \"isyançılar\" division_template = \"Crimea Division\" start_experience_factor = 0.2" 
						owner = PREV
					}
				}
				set_politics = { ruling_party = neutrality elections_allowed = no }
				add_popularity = {
					ideology = neutrality
					popularity = 0.70
				}
			}
		}
	}

	#Play as
	option = {
		name = sterbenka.6.a
		ai_chance = {
			factor = 0
		}
		declare_war_on = {
			target = CRI
			type = annex_everything
		}
		CRI = { change_tag_from = ROOT }
	}
	
	#Kill that
	option = {
		name = sterbenka.6.b
		ai_chance = {
			factor = 50
		}
		declare_war_on = {
			target = CRI
			type = annex_everything
		}
	}
	
	#Peace out
	option = {
		name = sterbenka.6.c
		ai_chance = {
			factor = 50
		}
		add_war_support = -0.05
		add_stability = 0.1
	}
}

# Territories for puppets
country_event = {
	id = sterbenka.7
	title = sterbenka.7.t
	desc = sterbenka.7.d
	picture = GFX_report_event_romania_poland_visit
	
	is_triggered_only = yes

	#Agree
	option = {
		name = sterbenka.7.a
		ai_chance = {
			factor = 100
		}
		set_temp_variable = { poland_territories_for_puppet_var = this }
		save_event_target_as = poland_territories_for_puppet_target
		THIS = {
			FROM = {
				every_owned_state = {
					limit = { is_core_of = var:poland_territories_for_puppet_var }
					ROOT = { transfer_state = PREV }
				}
			}
			every_core_state = {
				limit = {
					is_core_of = POL
				}
				remove_core_of = POL
			}
		}
		FROM = { set_autonomy = { target = PREV autonomy_state = autonomy_integrated_puppet } }
		FROM = {
			country_event = {
				id = sterbenka.8
				days = 1
			}
		}
	}
	
	#Fuck you Poland
	option = {
		name = sterbenka.7.b
		ai_chance = {
			factor = 0
		}
		FROM = {
			country_event = {
				id = sterbenka.9
				days = 1
			}
		}
	}
}

# They agree
