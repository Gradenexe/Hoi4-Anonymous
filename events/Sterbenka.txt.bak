}

add_namespace = International_STE

	#Request to do excavation research with Belarus
country_event = {
	id = International_STE.8
	title = International_STE.8.t
	desc = International_STE.8.d
	picture = GFX_report_event_physics_lab_01
	
	is_triggered_only = yes

	option = { #Great idea!
		name = International_STE.8.a
		ai_chance = {
			base = 10
		}
		add_tech_bonus = {
			name = BLR_autarky_res
			bonus = 0.5
			uses = 1
			technology = excavation1
			technology = excavation2
			technology = excavation3
			technology = excavation4
			technology = excavation5
		}
		FROM = {
			add_tech_bonus = {
				name = BLR_autarky_res
				bonus = 1.0
				uses = 1
				technology = excavation1
				technology = excavation2
				technology = excavation3
				technology = excavation4
				technology = excavation5
			}
		}
		FROM = { country_event = International_STE.9 }
	}

	option = { #Nope
		name = International_STE.8.b
		ai_chance = {
			base = 0
		}
		FROM = { country_event = International_STE.10 }
	}
}

