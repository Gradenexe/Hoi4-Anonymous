add_namespace = sterbenka

# fall of soviet union
country_event = {
	id = sterbenka.1
	title = sterbenka.1.t
	desc = sterbenka.1.d
	picture = GFX_decision_cat_picture_soviet_civil_war
	
	trigger = {
		NOT = { original_tag = SOV }
		has_war_with = SOV
		SOV = { surrender_progress > 0.85 }
		controls_state = 219 #Moscov
		controls_state = 195 #Leningrad
		controls_state = 217 #Stalingrad
		controls_state = 229 #Baku
		controls_state = 213 #Murmansk
		controls_state = 206 #Minsk
		controls_state = 202 #Kyiv
		controls_state = 137 #Crimea
	}

	#ok
	option = {
		name = sterbenka.1.a
		ai_chance = {
			factor = 100
		}
		white_peace = SOV
		every_faction_member = {
			white_peace = SOV
		}
		every_state = { 
			limit = {
				is_on_continent = europe
				or = {
					is_owned_by = SOV 
					owner = {
						is_subject_of = SOV
					}
				}
			}
			transfer_state_to = PREV
		}
		every_country = {
			limit = {
				is_subject_of = SOV
			}
			set_autonomy = { target = THIS autonomy_state = autonomy_free }
		}
		SOV = { 
			add_ideas = anti_german_military
			set_cosmetic_tag = SOV_red_army
		}
	}
	
	#NEIN!
	option = {
		name = sterbenka.1.b
		ai_chance = {
			factor = 0
		}
		add_war_support = 0.1
	}
}

# Bukhara rebelion
country_event = {
	id = sterbenka.2
	title = sterbenka.2.t
	desc = sterbenka.2.d
	picture = GFX_decision_cat_picture_soviet_civil_war
	
	trigger = {
		tag = UZB
		UZB = { 
			is_subject = no 
			exists = yes
		}
		830 = { is_controlled_by = UZB }
	}
	
	immediate = {
		hidden_effect = {
			UZB = { release_on_controlled = BUK }
			TAJ = {
				declare_war_on = {
					target = BUK
					type = annex_everything
				}
			}
			every_country = {
				limit = {
					original_tag = BUK
					has_civil_war = yes
				}
				declare_war_on = {
					target = BUK
					type = annex_everything
				}
			}
			BUK = {
				division_template = {
					name = "Bukhara Division"
					priority = 1
					division_names_group = BUK_INF_01
					regiments = {
						infantry = { x = 0 y = 0 }
						infantry = { x = 0 y = 1 }
						infantry = { x = 0 y = 2 }
				
						infantry = { x = 1 y = 0 }
						infantry = { x = 1 y = 1 }
						infantry = { x = 1 y = 2 }
					}
					support = {
						engineer = { x = 0 y = 0 }
					}
				}
				random_owned_controlled_state = {
					limit = { PREV = { has_full_control_of_state = PREV } }
					create_unit = {
						division = "name = \"qoʻzgʻolonchi\" division_template = \"Bukhara Division\" start_experience_factor = 0.2" 
						owner = PREV
					}
				}
				random_owned_controlled_state = {
					limit = { PREV = { has_full_control_of_state = PREV } }
					create_unit = {
						division = "name = \"qoʻzgʻolonchi\" division_template = \"Bukhara Division\" start_experience_factor = 0.2" 
						owner = PREV
					}
				}
				random_owned_controlled_state = {
					limit = { PREV = { has_full_control_of_state = PREV } }
					create_unit = {
						division = "name = \"qoʻzgʻolonchi\" division_template = \"Bukhara Division\" start_experience_factor = 0.2" 
						owner = PREV
					}
				}
				random_owned_controlled_state = {
					limit = { PREV = { has_full_control_of_state = PREV } }
					create_unit = {
						division = "name = \"qoʻzgʻolonchi\" division_template = \"Bukhara Division\" start_experience_factor = 0.2" 
						owner = PREV
					}
				}
				set_politics = { ruling_party = neutrality elections_allowed = no }
				add_popularity = {
					ideology = neutrality
					popularity = 0.70
				}
			}
		}
	}

	#Play as
	option = {
		name = sterbenka.2.a
		ai_chance = {
			factor = 0
		}
		declare_war_on = {
			target = BUK
			type = annex_everything
		}
		BUK = { change_tag_from = ROOT }
	}
	
	#Kill that
	option = {
		name = sterbenka.2.b
		ai_chance = {
			factor = 95
		}
		declare_war_on = {
			target = BUK
			type = annex_everything
		}
	}
	
	#Peace out
	option = {
		name = sterbenka.2.c
		ai_chance = {
			factor = 5
		}
		add_war_support = -0.05
		add_stability = 0.1
	}
}

