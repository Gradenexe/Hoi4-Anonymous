ROM_be_nice_to_hitler = {
	allowed = {
		original_tag = ROM
	}
	enable = {
		has_completed_focus = ROM_trade_treaty_with_germany
	}
	abort={
		is_in_faction = yes
	}

	ai_strategy = {
		type = befriend
		id = GER
		value = 200
	}
}

ROM_build_early_civ = {
	allowed = {
		original_tag = ROM
	}
	enable = {
		date < 1939.1.1
		has_war = no
	}
	
	abort_when_not_enabled = yes
	
	ai_strategy = {
		type = building_target
		id = industrial_complex
		value = 85
	}
}

ROM_build_army = {
	allowed = {
		original_tag = ROM
	}
	enable = {
		OR = {
			has_completed_focus = ROM_balkans_dominance
			has_completed_focus = ROM_preserve_greater_romania
		}
	}
	abort = {
		OR = {
			date > 1939.06.01
			has_army_manpower = { size > 600000 }
		}
	}
	ai_strategy = { type = build_army id = infantry value = 500 }
	ai_strategy = { type = force_build_armies value = 500 }
	#ai_strategy = { type = equipment_production_min_factories_archetype id = infantry_equipment value = 10 }
	#ai_strategy = { type = equipment_production_min_factories_archetype id = support_equipment value = 3 }
	#ai_strategy = { type = equipment_production_min_factories_archetype id = motorized_equipment value = 3 }
}

ROM_default_production = {
	allowed = {
		original_tag = ROM
	}
	
	enable = { is_major = no }

	abort_when_not_enabled = yes

	ai_strategy = { type = equipment_variant_production_factor id = infantry_equipment value = 50 }

	# ai_strategy = { type = air_factory_balance                                  value = -25 }
}

#If you went democratic don't die to surprise Hungary and Bulgaria
ROM_garrison = {
	allowed = { tag = ROM }
	enable = {
		is_in_faction_with = ENG
		# FRA = { has_capitulated = yes }
		has_war_with = GER
		NOT = { has_war_with = HUN }
		NOT = { has_war_with = BUL }
	}
	abort_when_not_enabled = yes

	ai_strategy = { type = garrison value = 200 }
}

